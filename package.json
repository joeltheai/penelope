{
  "name": "penelope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web painting app with stylus/pen support",
  "scripts": {
    "wasm:build": "wasm-pack build crate --target web --out-dir pkg --release",
    "wasm:test": "cargo test --manifest-path crate/Cargo.toml",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:full": "pnpm build",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "pnpm build:full && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.26.0"
  },
  "packageManager": "pnpm@11.18.0"
}
