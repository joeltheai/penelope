{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "Q5": "readonly"
  },
  "ignorePatterns": ["dist/**", ".wrangler/**", "node_modules/**"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-explicit-any": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "q5"]
      }
    ]
  }
}
